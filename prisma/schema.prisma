generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SituationStatus {
  ACTIVE
  ARCHIVED
}

enum ActionStatus {
  PROPOSED
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum DocumentProcessingStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  createdAt DateTime @default(now())
  situations SituationMember[]
  documents Document[]
  actions Action[] @relation("ActionAssignee")
  notifications Notification[]
  consents Consent[]
}

model Situation {
  id String @id @default(cuid())
  title String
  status SituationStatus @default(ACTIVE)
  progress Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members SituationMember[]
  documents Document[]
  events Event[]
  actions Action[]
  insights Insight[]
  missingItems MissingItem[]
  entities SituationEntity[]
  aiRuns AIRun[]
  notifications Notification[]
  jobs Job[]
  replays SituationReplay[]
  consents Consent[]
}

model SituationMember {
  situationId String
  userId String
  role String @default("member")
  situation Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([situationId, userId])
}

model Document {
  id String @id @default(cuid())
  situationId String
  ownerId String
  name String
  mimeType String
  sizeBytes Int
  storageKey String
  extractedText String?
  createdAt DateTime @default(now())
  situation Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]
  chunks DocumentChunk[]
  citations Citation[]
  processingStatus DocumentProcessingStatus @default(QUEUED)
  processingError String?
  processedAt DateTime?
}

model DocumentVersion {
  id String @id @default(cuid())
  documentId String
  version Int
  storageKey String
  extractedText String?
  createdAt DateTime @default(now())
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, version])
}

model DocumentChunk {
  id String @id @default(cuid())
  documentId String
  chunkIndex Int
  content String
  embeddingModel String?
  embedding Json?
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, chunkIndex])
}

model Citation {
  id String @id @default(cuid())
  documentId String
  sourceText String
  page Int?
  startOffset Int?
  endOffset Int?
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actionEvidence ActionEvidence[]
  entityRelationships EntityRelationship[]
}

model Event {
  id String @id @default(cuid())
  situationId String
  title String
  description String?
  occurredAt DateTime?
  createdAt DateTime @default(now())
  situation Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
}

model Action {
  id String @id @default(cuid())
  situationId String
  assigneeId String?
  title String
  description String?
  status ActionStatus @default(PROPOSED)
  dueAt DateTime?
  approvedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  situation Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  assignee User? @relation("ActionAssignee", fields: [assigneeId], references: [id])
  evidence ActionEvidence[]
  dependencies ActionDependency[] @relation("ActionDependencies")
  dependents ActionDependency[] @relation("ActionDependents")
}

model ActionEvidence {
  id String @id @default(cuid())
  actionId String
  citationId String?
  note String?
  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
  citation Citation? @relation(fields: [citationId], references: [id], onDelete: SetNull)
}

model ActionDependency {
  actionId String
  dependsOnActionId String
  action Action @relation("ActionDependencies", fields: [actionId], references: [id], onDelete: Cascade)
  dependsOn Action @relation("ActionDependents", fields: [dependsOnActionId], references: [id], onDelete: Cascade)
  @@id([actionId, dependsOnActionId])
}

model Insight {
  id String @id @default(cuid())
  situationId String
  type String
  title String
  detail String
  confidence Float?
  createdAt DateTime @default(now())
  situation Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
}

model MissingItem {
  id String @id @default(cuid())
  situationId String
  label String
  reason String?
  resolved Boolean @default(false)
  createdAt DateTime @default(now())
  situation Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
}

model Entity {
  id String @id @default(cuid())
  kind String
  name String
  normalizedName String
  createdAt DateTime @default(now())
  situations SituationEntity[]
  outgoing EntityRelationship[] @relation("RelationshipFrom")
  incoming EntityRelationship[] @relation("RelationshipTo")
  @@unique([kind, normalizedName])
}

model SituationEntity {
  situationId String
  entityId String
  confidence Float?
  situation Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  @@id([situationId, entityId])
}

model EntityRelationship {
  id String @id @default(cuid())
  fromEntityId String
  toEntityId String
  type String
  confidence Float?
  sourceCitationId String?
  fromEntity Entity @relation("RelationshipFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity Entity @relation("RelationshipTo", fields: [toEntityId], references: [id], onDelete: Cascade)
  sourceCitation Citation? @relation(fields: [sourceCitationId], references: [id], onDelete: SetNull)
}

model AIRun {
  id String @id @default(cuid())
  situationId String
  provider String
  model String
  task String
  status String
  inputHash String?
  outputJson Json?
  error String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  situation Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
}

model Notification {
  id String @id @default(cuid())
  situationId String
  userId String?
  channel String
  status NotificationStatus @default(PENDING)
  title String
  body String
  scheduledFor DateTime?
  sentAt DateTime?
  createdAt DateTime @default(now())
  situation Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Playbook {
  id String @id @default(cuid())
  name String
  description String?
  createdAt DateTime @default(now())
  steps PlaybookStep[]
}

model PlaybookStep {
  id String @id @default(cuid())
  playbookId String
  position Int
  title String
  description String?
  playbook Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  @@unique([playbookId, position])
}

model Job {
  id String @id @default(cuid())
  situationId String
  type String
  status JobStatus @default(QUEUED)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  lockedAt DateTime?
  lastError String?
  payload Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  situation Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  @@index([status, availableAt])
}

model SituationReplay {
  id String @id @default(cuid())
  situationId String
  version Int
  snapshot Json
  createdAt DateTime @default(now())
  situation Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  @@unique([situationId, version])
}

model Consent {
  id String @id @default(cuid())
  situationId String
  userId String
  purpose String
  granted Boolean
  grantedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  situation Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([situationId, userId, purpose])
}

model AuditEvent {
  id String @id @default(cuid())
  actorId String?
  action String
  entityType String
  entityId String
  metadata Json?
  createdAt DateTime @default(now())
}
